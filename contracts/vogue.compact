// ============================================================================
// Vogue — Privacy-First Natural-Language Trading Agent Contract (Core v1)
// ============================================================================
// PRIVACY MODEL:
// 1. PUBLIC LEDGER STATE (ON-CHAIN):
//    - agentCommitment: Maps agentId (Bytes<32>) -> strategy commitment hash (Bytes<32>).
//    - strategyOwner: Maps agentId (Bytes<32>) -> owner cryptographic commitment.
//    - tradeStatus: Maps tradeId (Bytes<32>) -> Uint<8> status (0=pending, 1=executed, 2=rejected, 3=withdrawn).
//    - tradeNullifiers: Maps tradeNullifier (Bytes<32>) -> Boolean (explicit replay protection).
//    - tradeCount: Counter tracking total proven trades executed by the agent.
//    - darkIntentCommitment: Maps intentId -> private intent hash.
//    - darkIntentStatus: Maps intentId -> status.
//    - darkIntentCount: Counter for dark pool intents.
//    - authorizedSolvers: Maps solverId -> Boolean authorized status.
//
// 2. PRIVATE WITNESSES (SHIELDED, CLIENT-SIDE ONLY):
//    - Strategy parameters: maxPositionPct, stopLossPct, expiry.
//    - Portfolio state: total portfolio value USD, private secret key.
//    - Trade details: asset, size USD.
//    - Dark pool: intent asset, fill bounds, price limits, escrow.
//    - Never broadcast or stored on ledger.
//
// 3. ZERO-KNOWLEDGE PROOF GUARANTEES:
//    - Cryptographically authenticates strategy ownership via localSecretKey commitment.
//    - Proves trade adheres to the SAME strategy committed in agentCommitment.
//    - Consumes unique trade nullifier to prevent double-execution / proof replay.
//    - Proves trade size <= maxPositionPct of current portfolio value.
//    - Binds dark intent fulfillment to authorized solvers within committed price/asset bounds.
//    - Discloses ONLY execution status. Zero private strategy parameters exposed.
// ============================================================================

pragma language_version >= 0.16 && <= 0.25;
import CompactStandardLibrary;

// ---------- PUBLIC LEDGER STATE ----------
export ledger agentCommitment: Map<Bytes<32>, Bytes<32>>;   // agentId -> strategy hash
export ledger strategyOwner: Map<Bytes<32>, Bytes<32>>;     // agentId -> owner authorization commitment
export ledger tradeStatus: Map<Bytes<32>, Uint<8>>;         // tradeId -> 0=pending, 1=executed, 2=rejected, 3=withdrawn
export ledger tradeNullifiers: Map<Bytes<32>, Boolean>;     // tradeNullifier -> true (replay protection)
export ledger tradeCount: Counter;
export ledger darkIntentCommitment: Map<Bytes<32>, Bytes<32>>;   // intentId -> private intent hash
export ledger darkIntentStatus: Map<Bytes<32>, Uint<8>>;         // intentId -> 0=none, 1=committed, 2=filled, 3=refunded
export ledger darkIntentCount: Counter;
export ledger authorizedSolvers: Map<Bytes<32>, Boolean>;        // solverId -> true (authorized solver)

// ---------- PRIVATE WITNESSES ----------
witness getMaxPositionPct(): Uint<8>;
witness getStopLossPct(): Uint<8>;
witness getStrategyExpiry(): Uint<64>;
witness getPortfolioValue(): Uint<64>;
witness getTradeAsset(): Bytes<32>;
witness getTradeSizeUsd(): Uint<64>;
witness localSecretKey(): Bytes<32>;
witness getRiskCheckPassed(): Boolean;
witness getDepositTNightAmount(): Uint<64>;
witness getBurnTNightAmount(): Uint<64>;
witness getTNightPriceUsd(): Uint<64>;
witness getIntentAsset(): Bytes<32>;
witness getMinFillAmount(): Uint<64>;
witness getMaxPriceLimit(): Uint<64>;
witness getIntentExpiry(): Uint<64>;
witness getEscrowVusdAmount(): Uint<64>;

// ---------- CIRCUITS ----------

// Run once per strategy: commit the parsed risk bounds (max position %, stop-loss %, expiry) and bind owner key
export circuit commitStrategy(agentId: Bytes<32>): [] {
  const callerId = disclose(persistentHash<Vector<2, Bytes<32>>>([localSecretKey(), agentId]));
  const strategyHash = disclose(
    persistentHash<Vector<3, Bytes<32>>>([
      getMaxPositionPct() as Field as Bytes<32>,
      getStopLossPct() as Field as Bytes<32>,
      getStrategyExpiry() as Field as Bytes<32>
    ])
  );
  agentCommitment.insert(disclose(agentId), strategyHash);
  strategyOwner.insert(disclose(agentId), callerId);
}

// Run per trade: proves trade adheres to committed risk bounds, validates owner secret, and consumes trade nullifier
export circuit executeTrade(agentId: Bytes<32>, tradeId: Bytes<32>, currentTime: Uint<64>): [] {
  // 1. Cryptographic caller authorization
  const callerId = disclose(persistentHash<Vector<2, Bytes<32>>>([localSecretKey(), agentId]));
  assert(strategyOwner.lookup(disclose(agentId)) == callerId, "unauthorized caller for strategy");

  // 2. Replay protection and trade nullifier check
  assert(!tradeStatus.member(disclose(tradeId)), "trade already executed");
  const tradeNullifier = disclose(persistentHash<Vector<2, Bytes<32>>>([localSecretKey(), tradeId]));
  assert(!tradeNullifiers.member(tradeNullifier), "trade nullifier already spent");
  tradeNullifiers.insert(tradeNullifier, true);

  // 3. Strategy integrity & timeline verification
  const recomputedHash = disclose(
    persistentHash<Vector<3, Bytes<32>>>([
      getMaxPositionPct() as Field as Bytes<32>,
      getStopLossPct() as Field as Bytes<32>,
      getStrategyExpiry() as Field as Bytes<32>
    ])
  );
  assert(agentCommitment.lookup(disclose(agentId)) == recomputedHash, "trade does not match committed strategy");
  assert(currentTime <= getStrategyExpiry(), "strategy timeline expired");

  // Dynamic position-size check measured against live Shielded Vault balance (getPortfolioValue)
  assert((getTradeSizeUsd() * (100 as Uint<64>)) <= (getPortfolioValue() * (getMaxPositionPct() as Uint<64>)), "exceeds max position size");
  assert(getRiskCheckPassed(), "risk model check failed");

  tradeStatus.insert(disclose(tradeId), disclose(1 as Uint<8>));
  tradeCount.increment(1);
}

// Mint: deposit tNIGHT and convert to private USDC-equivalent balance note with replay protection
export circuit mintVaultBalance(agentId: Bytes<32>, depositId: Bytes<32>): [] {
  assert(!tradeStatus.member(disclose(depositId)), "deposit already processed");
  assert(getDepositTNightAmount() > (0 as Uint<64>), "invalid deposit amount");
  assert(getTNightPriceUsd() > (0 as Uint<64>), "invalid tNIGHT price");
  tradeStatus.insert(disclose(depositId), disclose(1 as Uint<8>));
}

// Burn: convert private vault balance back to tNIGHT and unshield to public wallet with replay protection
export circuit burnVaultBalance(agentId: Bytes<32>, burnId: Bytes<32>, withdrawUsdcAmount: Uint<64>): [] {
  assert(!tradeStatus.member(disclose(burnId)), "burn already processed");
  assert(withdrawUsdcAmount > (0 as Uint<64>), "invalid withdraw amount");
  assert(withdrawUsdcAmount <= getPortfolioValue(), "insufficient vault balance");
  assert(getTNightPriceUsd() > (0 as Uint<64>), "invalid tNIGHT price");
  tradeStatus.insert(disclose(burnId), disclose(3 as Uint<8>));
}

// Withdraw: unshield private balance note back to public wallet balance
export circuit unshieldWithdraw(agentId: Bytes<32>, amountUsd: Uint<64>): [] {
  assert(amountUsd <= getPortfolioValue(), "insufficient private balance");
  tradeStatus.insert(disclose(agentId), disclose(3 as Uint<8>));
}

// Register an authorized solver on-chain
export circuit registerAuthorizedSolver(solverId: Bytes<32>): [] {
  authorizedSolvers.insert(disclose(solverId), true);
}

// Commit a private dark intent with locked escrow vUSD and private limit price / asset bounds
export circuit commitDarkIntent(agentId: Bytes<32>, intentId: Bytes<32>): [] {
  assert(getEscrowVusdAmount() > (0 as Uint<64>), "invalid escrow amount");
  assert(getEscrowVusdAmount() <= getPortfolioValue(), "insufficient vault collateral for intent");

  const intentHash = disclose(
    persistentHash<Vector<4, Bytes<32>>>([
      getIntentAsset(),
      getMinFillAmount() as Field as Bytes<32>,
      getMaxPriceLimit() as Field as Bytes<32>,
      getIntentExpiry() as Field as Bytes<32>
    ])
  );
  darkIntentCommitment.insert(disclose(intentId), intentHash);
  darkIntentStatus.insert(disclose(intentId), disclose(1 as Uint<8>));
  darkIntentCount.increment(1);
}

// Atomically fulfill dark intent when authorized solver provides verified fill within price bounds
export circuit fulfillDarkIntent(intentId: Bytes<32>, solverId: Bytes<32>, fillPriceUsd: Uint<64>, currentTime: Uint<64>): [] {
  assert(authorizedSolvers.member(disclose(solverId)), "unauthorized solver");
  assert(darkIntentStatus.lookup(disclose(intentId)) == (1 as Uint<8>), "intent not in committed state");
  assert(currentTime <= getIntentExpiry(), "intent expired");
  assert(fillPriceUsd <= getMaxPriceLimit(), "fill price exceeds max price limit");

  const recomputedIntentHash = disclose(
    persistentHash<Vector<4, Bytes<32>>>([
      getIntentAsset(),
      getMinFillAmount() as Field as Bytes<32>,
      getMaxPriceLimit() as Field as Bytes<32>,
      getIntentExpiry() as Field as Bytes<32>
    ])
  );
  assert(darkIntentCommitment.lookup(disclose(intentId)) == recomputedIntentHash, "intent parameters mismatch");

  darkIntentStatus.insert(disclose(intentId), disclose(2 as Uint<8>));
}

// Refund escrowed vUSD if intent remains unfilled past intent expiry timeline
export circuit refundDarkIntent(intentId: Bytes<32>, currentTime: Uint<64>): [] {
  assert(darkIntentStatus.lookup(disclose(intentId)) == (1 as Uint<8>), "intent not eligible for refund");
  assert(currentTime > getIntentExpiry(), "intent not yet expired");
  darkIntentStatus.insert(disclose(intentId), disclose(3 as Uint<8>));
}
